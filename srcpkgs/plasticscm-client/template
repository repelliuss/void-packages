 c2ddfecb1396baecf892ec261e7deccfebea7bd067b2f42eb162c7f20c658a59"

skip_extraction="
 plasticscm-client-core_${version}_amd64.deb
 plasticscm-client-gui_${version}_amd64.deb
 plasticscm-theme_${version}_amd64.deb
 plasticscm-server-core_${version}_amd64.deb"

do_extract() {
	local debdir="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	for deb in "${debdir}"/*.deb; do
		ar x "${deb}"
		bsdtar xf data.tar.xz -C "${wrksrc}"
		rm -f data.tar.xz control.tar.gz control.tar.xz debian-binary
	done
}

do_install() {
	# Install /opt/plasticscm5 tree (client + server + theme)
	vmkdir opt/plasticscm5
	vcopy "${wrksrc}/opt/plasticscm5" opt/

	# /usr/bin symlinks
	vmkdir usr/bin
	ln -sfr "${DESTDIR}/opt/plasticscm5/client/cm" \
		"${DESTDIR}/usr/bin/cm"
	ln -sfr "${DESTDIR}/opt/plasticscm5/client/linplasticx" \
		"${DESTDIR}/usr/bin/plasticgui"
	ln -sfr "${DESTDIR}/opt/plasticscm5/client/lingluonx" \
		"${DESTDIR}/usr/bin/gluon"

	# Desktop entries from the gui package
	vcopy "${wrksrc}/usr/share/applications" usr/share/
}

post_install() {
	vsv plasticscm-server
}
