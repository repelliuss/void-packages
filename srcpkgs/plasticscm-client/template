# Template file for 'plasticscm-client'
pkgname=plasticscm-client
version=11.0.16.10042
revision=1
archs="x86_64"
short_desc="Unity Version Control (Plastic SCM) - full client with GUI and server"
maintainer="Sami Batuhan Basmaz Olmez <sb.basmazolmez@gmail.com>"
license="custom:Proprietary"
homepage="https://www.plasticscm.com"
repository=nonfree
restricted=yes
nostrip=yes
nopie=yes
create_wrksrc=yes

system_accounts="_plasticscm"
_plasticscm_homedir="/var/lib/plasticscm"
make_dirs="/var/lib/plasticscm 0750 _plasticscm _plasticscm"

_baseurl="https://www.plasticscm.com/plasticrepo/stable/debian/./amd64"
distfiles="
 ${_baseurl}/plasticscm-client-core_${version}_amd64.deb
 ${_baseurl}/plasticscm-client-gui_${version}_amd64.deb
 ${_baseurl}/plasticscm-theme_${version}_amd64.deb
 ${_baseurl}/plasticscm-server-core_${version}_amd64.deb"
checksum="
 fd62f9e418dc9c619d29644d4fab8d9ad287ad8e1171ac8a9e9be7e1235a3f1b
 0051404fbe4e2f2fb635b0bfdefdb140ce44a4838da121ba424deb7253287794
